# ========================================================
# PROYECTO RIFA - VARIABLES DE ENTORNO DE EJEMPLO
# ========================================================
# Copia este archivo como .env.local para desarrollo local:
#   cp .env.example .env.local
#
# IMPORTANTE: Nunca subas el archivo .env o .env.local a Git.
# ========================================================

# Base de datos:
# Para desarrollo local (SQLite en archivo local):
DATABASE_URL="file:./rifa.db"
# Para despliegue gratuito en la nube (Turso LibSQL - Gratuito $0):
# DATABASE_URL="libsql://tu-base-de-datos.turso.io"
# DATABASE_AUTH_TOKEN="tu-token-de-turso-aqui"

# Clave secreta para sesiones y tokens de administradores (mínimo 32 caracteres seguros):
ADMIN_SECRET_KEY="clave_secreta_super_segura_cambiar_en_produccion_minimo_32_caracteres"

# Administradores iniciales para el primer inicio / seed:
DEFAULT_ADMIN1_USERNAME="alan"
DEFAULT_ADMIN1_PASSWORD="CambiarPasswordSeguro1!"
DEFAULT_ADMIN1_NAME="Alan"

DEFAULT_ADMIN2_USERNAME="yilda"
DEFAULT_ADMIN2_PASSWORD="CambiarPasswordSeguro2!"
DEFAULT_ADMIN2_NAME="Yilda"

# URL pública de la aplicación (usada para generar los enlaces privados):
# En local:
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# En producción (ej. Vercel o Cloudflare Tunnel):
# NEXT_PUBLIC_APP_URL="https://tu-rifa.vercel.app"
